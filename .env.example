# =============================================================================
# BANKR MONITOR - ENVIRONMENT VARIABLES
# =============================================================================
# Copy this to .env and fill in your values
# All variables marked (REQUIRED) must be set for the system to work
# Variables marked (OPTIONAL) can be left blank or commented out

# =============================================================================
# REDIS (Docker) - REQUIRED
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# =============================================================================
# POSTGRES (Docker) - REQUIRED
# =============================================================================
POSTGRES_HOST=postgres
POSTGRES_USER=bankr
POSTGRES_PASSWORD=""
POSTGRES_DB=bankr_monitor

# =============================================================================
# BLOCKCHAIN RPC (Base Network) - REQUIRED
# =============================================================================
# Primary RPC (Ankr Premium recommended)
# Get from https://ankr.com
ANKR_RPC_HTTP=https://rpc.ankr.com/base/YOUR_KEY
ANKR_RPC_WSS=wss://rpc.ankr.com/base/ws/YOUR_KEY

# Multiple RPC URLs for failover (comma-separated) - OPTIONAL
# If set, will rotate between these if primary fails
# BASE_RPC_URLS=https://mainnet.base.org,https://base.llamarpc.com,https://rpc.ankr.com/base

# =============================================================================
# TWITTER API - REQUIRED
# =============================================================================
# Get from https://twitterapi.io
TWITTER_API_KEY=""

# =============================================================================
# TELEGRAM BOTS - REQUIRED
# =============================================================================
# Create bots at @BotFather
# Each bot needs to be admin of its respective channel/group

# -----------------------------------------------------------------------------
# MAIN BOT - Deployed token alerts (public channel)
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHANNEL_ID=-1001234567890

# -----------------------------------------------------------------------------
# PRE-BANKR BOT - Pre-bankr alerts (public channel)
# Uses same bot as MAIN, different channel
# -----------------------------------------------------------------------------
TELEGRAM_PREBANKR_CHANNEL_ID=-1001234567891

# -----------------------------------------------------------------------------
# BOT POOL - Multiple bots to avoid rate limits (OPTIONAL)
# Comma-separated tokens, all must be admin of DEPLOYED and PREBANKR channels
# -----------------------------------------------------------------------------
# TELEGRAM_BOT_POOL_TOKENS=token1,token2,token3

# -----------------------------------------------------------------------------
# TRADING BOT - Interactive trading (private)
# Separate bot recommended for security
# -----------------------------------------------------------------------------
TELEGRAM_TRADING_BOT_TOKEN=""

# -----------------------------------------------------------------------------
# CALLBACK BOT - Button interactions (private)
# Can be same as trading bot or separate
# -----------------------------------------------------------------------------
TELEGRAM_CALLBACK_BOT_TOKEN=""

# -----------------------------------------------------------------------------
# CLAWNCH BOT - Moltbook/MoltX/4claw alerts (separate channel)
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN_CLAWNCH=""
TELEGRAM_CHAT_ID_PRECLAWNCH=-1001234567892
TELEGRAM_CHAT_ID_CLAWNCH=-1001234567893
TELEGRAM_CLAWNCH_CHANNEL_ID=-1001234567893

# -----------------------------------------------------------------------------
# MOLT CHANNELS - Moltbook-specific alerts (OPTIONAL)
# -----------------------------------------------------------------------------
# TELEGRAM_CHAT_ID_MOLT=-1001234567894
# TELEGRAM_CHAT_ID_MOLT_KOL=-1001234567895

# -----------------------------------------------------------------------------
# TRACKER BOT - Token tracking alerts (OPTIONAL)
# -----------------------------------------------------------------------------
# TELEGRAM_TRACKER_BOT_TOKEN=your_tracker_bot_token

# -----------------------------------------------------------------------------
# ADMIN BOT - Admin commands/alerts (OPTIONAL)
# -----------------------------------------------------------------------------
# TELEGRAM_ADMIN_BOT_TOKEN=your_admin_bot_token
# TELEGRAM_ADMIN_GROUP_ID=-1001234567896

# -----------------------------------------------------------------------------
# NEW INTERFACE ALERTS - Alert when new Clanker interface detected (OPTIONAL)
# -----------------------------------------------------------------------------
# TELEGRAM_NEWINTERFACE_CHANNEL_ID=-1001234567897

# =============================================================================
# LLM (Tweet Classification) - REQUIRED (at least one)
# =============================================================================
# Option 1: Google AI (recommended)
GOOGLE_API_KEY=""
GEMINI_MODEL=gemini-2.0-flash

# Option 2: OpenRouter (backup)
# OPENROUTER_API_KEY=your_openrouter_key
# OPENROUTER_MODEL=google/gemini-2.0-flash-001

# =============================================================================
# ALPHAGATE (Smart Followers, R/C counts) - OPTIONAL
# =============================================================================
# Get from browser cookies after logging into alphagate.xyz
# Without this, smart followers won't be displayed
# ALPHAGATE_USER_ID=your_user_id
# ALPHAGATE_SESSION_ID=your_session_id

# =============================================================================
# TRADING WALLET - OPTIONAL (but required for actual trading)
# =============================================================================
# Only add if you want to enable real swaps
# NEVER commit these values to git!
# TRADING_WALLET_ADDRESS=0x...
# TRADING_WALLET_PRIVATE_KEY=your_private_key_without_0x

# =============================================================================
# PROXY (Optional)
# =============================================================================
# For MoltX/Moltbook API requests if blocked from your IP
# Format: host:port:username:password
# HTTP_PROXY_CONFIG=86.109.82.97:12323:user:pass

# =============================================================================
# FEATURE FLAGS (Optional)
# =============================================================================
# FLASHBLOCKS_ENABLED=true
